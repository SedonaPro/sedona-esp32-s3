@palette=false
class LicensePlatformService extends PlatformService
{
	long startTime;
	define long maxUnlicensedRuntime = 7200L*(1000L*1000L*1000L); /* ns */
	define long licensePeriodCheck   = 60L*(1000L*1000L*1000L);   /* ns */
	define int featureBase = 1;
	define int bufLen = 255;

	@readonly
	property bool licensed = false;

	@readonly
	@asStr
	@max=120
	property Buf(bufLen) licenseRequest = "";

	@config
	@asStr
	@max=120
	property Buf(bufLen) licenseCode = "";


	long lastCheckTime;

	override virtual void start()
	{
		super.start();
		startTime = datetimeStd::DateTimeServiceStd.doNow();
		BclimateLicense.GetRequestString(featureBase, licenseRequest, licenseRequest.bytesLen);
		int len = licenseRequest.toStr().length() + 1;
		len = Sys.min(len, licenseRequest.bytesLen);
		licenseRequest.size = len;
		changed(LicensePlatformService.licenseRequest);

		licensed := BclimateLicense.SubmitLicenseKey(licenseRequest, licenseCode, featureBase);
	}

	virtual override void changed(Slot slot)
	{
                super.changed(slot);
		if (slot == LicensePlatformService.licenseCode) {
			licensed := BclimateLicense.SubmitLicenseKey(licenseRequest, licenseCode, featureBase);
		}
	}

	override virtual void execute()
	{
		super.execute();

		long now;
		long lastCheckDelta;
		now =  datetimeStd::DateTimeServiceStd.doNow();
		lastCheckDelta = Math.labs(now - lastCheckTime);

		if (lastCheckDelta > licensePeriodCheck) {
			lastCheckTime = now;
			if (!licensed) {
				long runtime;
				runtime = now - startTime;
				if (runtime > maxUnlicensedRuntime) {
					Sys.out.print("now: ${now}, start: ${startTime}, run: ${runtime}").nl();
					Sys.out.print("End of demo time. Shutdown SVM").nl();
					Sys.app.quit();
				}
			} else {
				/* check whether license still valid */
				licensed := BclimateLicense.SubmitLicenseKey(
					licenseRequest,
					licenseCode,
					featureBase);
				if (!licensed) {
					Sys.out.print("now: ${now}, start: ${startTime}").nl();
					Sys.out.print("License request: '"); Sys.out.print(licenseRequest.toStr()); Sys.out.print("'").nl();
					Sys.out.print("License code:    '"); Sys.out.print(licenseCode.toStr()); Sys.out.print("'").nl();
					Sys.out.print("featureBase:     ${featureBase}").nl();
					Sys.out.print("License is expired").nl();
				}
			}
		}
	}
}


class UnixPlatformService extends LicensePlatformService
{

	/*
	 * Returns true if the platform wants to the App to invoke work() again on
	 * all Services during free time before the next App execute needs to begin.
	 */
	override bool workDuringFreeTime(long nsUntilDeadline)
	{
		bool ret;
		ret = (nsUntilDeadline > 30000000L);
		if (ret) {
			Sys.sleep(2000000L);
		}
		return ret;
	}

	/*
	 * Action to reboot the entire host platform.  This typically
	 * means to reboot the entire operating system.
	 */
	@confirmRequired
	override action void reboot() {
		rebootSystem();
	}

	internal static native void rebootSystem();
}
