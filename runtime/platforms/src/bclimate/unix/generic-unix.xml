<!-- DON'T FORGET TO REPLACE VENDOR to BCLIMATE -->
<sedonaPlatform vendor="easyio" id="easyio-fg-${sedona.env.version}">

  <compile endian="little" blockSize="4" refSize="4" debug="true" test="true">

    <!-- Native Kits -->
    <nativeKit depend="sys 1.2+"    />
    <nativeKit depend="inet 1.2+"   />
    <nativeKit depend="datetimeStd 1.2+" />
    <nativeKit depend="bclimatePlatform 1.2+" />
    <nativeKit depend="bclimateMath 1.2+" />
    <nativeKit depend="bclimateModbusMaster 1.2+" />
    <nativeKit depend="bclimateModbusSlave 1.2+" />
    <nativeKit depend="bclimateLibNative 1.2+" />
    <nativeKit depend="bclimateSpi 1.2+" />
    <nativeKit depend="bclimateSqlite 1.2+" />
    <nativeKit depend="bclimateExpression 1.2+" />
    <nativeKit depend="serial 1.2+" />
    <nativeKit depend="communityMQTT 1.2+" />

    <!-- Sources -->
    <nativeSource path="/src/vm" />
    <nativeSource path="/src/sys/native" />
    <nativeSource path="/src/sys/native/std" />
    <nativeSource path="/src/sys/native/unix" />
    <nativeSource path="/src/inet/native" />
    <nativeSource path="/src/inet/native/std" />
    <nativeSource path="/src/inet/native/sha1" />
    <nativeSource path="/src/datetimeStd/native/std" />
    <nativeSource path="/src/bclimateModbusMaster/native" />
    <nativeSource path="/src/bclimateModbusSlave/native" />
    <nativeSource path="/src/bclimateLibNative/native" />
    <nativeSource path="/src/bclimateMath/native" />
    <nativeSource path="/src/bclimateSpi/native" />
    <nativeSource path="/src/bclimateSqlite/native" />
    <nativeSource path="/src/bclimateExpression/native" />
    <nativeSource path="/src/serial/native/linux" />
    <nativeSource path="/src/serial/native" />
    <nativeSource path="/src/tutorial/native" />
    <nativeSource path="/platforms/src/bclimate/unix/native" />
    <nativeSource path="/src/communityMQTT/native" />
  </compile>

  <manifestInclude>
    <schemes>
      <!-- unix supports manifest, platform and kits transfer -->
      <scheme id="m" transfer="single"/>
      <scheme id="k" transfer="single"/>
      <scheme id="p" transfer="single"/>
    </schemes>
  </manifestInclude>
</sedonaPlatform>
