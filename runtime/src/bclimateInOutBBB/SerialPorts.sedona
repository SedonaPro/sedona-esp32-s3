@palette=false
class SerialPorts {
	define int maxSerialPorts = 5;

	define Str[maxSerialPorts] portNames = { "",
				     "/dev/ttyUSB0",
				     "/dev/ttyUSB1",
				     "/dev/ttyO0",
				     "/dev/ttyO4"
	};

	static int getMaxPortNum() {
		return (maxSerialPorts - 1);
	}

	static void _sInit()
	{
		SerialInfoPlatform.setMaxPortNum(getMaxPortNum());
		for(int i=0; i<SerialPorts.maxSerialPorts; i++)
			SerialInfoPlatform.setPortName(i, portNames[i]);
	}

	static internal inline SerialPorts singlet;
}
