@palette=false
internal class GpioInputsInfo {

	define int maxPins = 4;
	define int[maxPins] pins = { 117, 115, 60, 61 };

	static bool isNumCorrect(int num)
	{
		return ((num <= maxPins) && (num > 0));
	}

	static int getLowLevelNum(int num)
	{
		int ret;
		if (isNumCorrect(num)) {
			ret = pins[num - 1];
		} else {
			ret = 0;
		}
		return ret;
	}
}

