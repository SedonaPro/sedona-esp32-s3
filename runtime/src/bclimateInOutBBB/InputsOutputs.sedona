class DigitalInput extends DigitalInputGeneric
{
	virtual override Str getVariableName(int n)
	{
		int ll_num = GpioInputsInfo.getLowLevelNum(n);
		str.copyFromStr(Sys.intStr(ll_num), varNameStrSize);
		return str;
	}

	virtual override bool checkNum(int n)
	{
		return GpioInputsInfo.isNumCorrect(n)
	}
}

class DigitalOutput extends DigitalOutputGeneric
{
	virtual override Str getVariableName(int n)
	{
		int ll_num = GpioOutputsInfo.getLowLevelNum(n);
		str.copyFromStr(Sys.intStr(ll_num), varNameStrSize);
		return str;
	}

	virtual override bool checkNum(int n)
	{
		return GpioOutputsInfo.isNumCorrect(n)
	}


	virtual override void execute()
	{
		super.execute();
		writeSysfsFile(out ? "1" : "0");
	}
}



class AnalogInput extends AnalogInputGeneric
{

	virtual override void loaded()
	{
		super.loaded();
		prefixName = "/sys/bus/iio/devices/iio:device0/in_voltage"
		suffixName = "_raw";
	}

	virtual override Str getVariableName(int n)
	{
		int ll_num = AnalogInputsInfo.getLowLevelNum(n);
		str.copyFromStr(Sys.intStr(ll_num), varNameStrSize);
		return str;
	}

	virtual override bool checkNum(int n)
	{
		return AnalogInputsInfo.isNumCorrect(n)
	}
}


class AnalogOutput extends AnalogOutputGeneric
{
	virtual override void loaded()
	{
		super.loaded();
		prefixName = "/dev/sedona/pwmchip0/pwm";
		suffixName = "";

		suffixNamePeriod = "/period";
		suffixNameDuty   = "/duty_cycle";
	}

	virtual override Str getVariableName(int n)
	{
		int ll_num = AnalogOutputsInfo.getLowLevelNum(n);
		str.copyFromStr(Sys.intStr(ll_num), varNameStrSize);
		return str;
	}

	virtual override bool checkNum(int n)
	{
		return AnalogOutputsInfo.isNumCorrect(n)
	}
}
