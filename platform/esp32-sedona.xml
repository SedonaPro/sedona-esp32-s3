<!--
  -  Sedona platform manifest: Bclimate ESP32-S3 (ESP-IDF).
  -  Paths are relative to the overlay sedona.home made by build.py
  -  (runtime sources under /src, this repository under /esp32).
  -->
<sedonaPlatform vendor="Bclimate" id="bclimate-esp32s3-${sedona.env.version}">

  <compile endian="little" blockSize="4" refSize="4" debug="true" test="true">

    <nativeKit depend="sys 1.2+" />
    <nativeKit depend="inet 1.2+" />
    <nativeKit depend="datetimeStd 1.2+" />
    <nativeKit depend="bclimateMath 1.2+" />
    <nativeKit depend="bclimateEsp32 1.2+" />

    <!-- runtime sources, unchanged -->
    <nativeSource path="/src/vm" />
    <nativeSource path="/src/sys/native" />
    <nativeSource path="/src/sys/native/std" />
    <nativeSource path="/src/inet/native" />
    <nativeSource path="/src/inet/native/std" />
    <nativeSource path="/src/inet/native/sha1" />
    <nativeSource path="/src/datetimeStd/native/std" />
    <nativeSource path="/src/bclimateMath/native" />
    <!-- ESP32 replacements for src/sys/native/unix and the platform kit -->
    <nativeSource path="/esp32/platform/sys_esp32" />
    <nativeSource path="/esp32/platform/bclimateEsp32/native" />
  </compile>

  <manifestInclude>
    <schemes>
      <scheme id="m" transfer="single"/>
      <scheme id="k" transfer="single"/>
      <scheme id="p" transfer="single"/>
    </schemes>
  </manifestInclude>
</sedonaPlatform>
